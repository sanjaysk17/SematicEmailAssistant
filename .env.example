# ============================================================
# AI-Powered Email Writing Assistant Configuration
# ============================================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
DISABLE_EMAIL_CONTENT_PERSISTENCE=false

# LLM Provider Configuration
# Supported providers: "mock", "openai", "local", "gemini"
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Local Ollama / vLLM Provider
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3:8b

# Gemini Provider
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# Generation Parameters
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=800

# Semantic & NLP Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
ENABLE_SPACY_EXTRACTION=true
SIMILARITY_THRESHOLD_PASS=0.70
SIMILARITY_THRESHOLD_REVIEW=0.50

# Database
DATABASE_URL=sqlite:///./email_assistant.db

# Vector Storage (Optional)
VECTOR_STORE_TYPE=in_memory
# Options: "in_memory", "chroma", "faiss"

# API & Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
